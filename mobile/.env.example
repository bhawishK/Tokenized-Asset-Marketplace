# Public configuration only. Use the SAME deployment as the original app.
EXPO_PUBLIC_PACKAGE_ID=0xYOUR_TESTNET_PACKAGE_ID
EXPO_PUBLIC_MARKETPLACE_ID=0xYOUR_SHARED_MARKETPLACE_ID
# HTTPS URL of THIS Expo web export, required for native wallet handoff.
# Keep blank until the web export is hosted. Never use the original Vite URL here.
EXPO_PUBLIC_WEB_APP_URL=
# Local connected-wallet demo funding service; contains no issuer credentials.
EXPO_PUBLIC_DEMO_FAUCET_URL=http://127.0.0.1:8788
